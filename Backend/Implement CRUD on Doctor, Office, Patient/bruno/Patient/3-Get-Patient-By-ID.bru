meta {
  name: Get Patient By ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/patient/{{patientId}}
  body: none
  auth: none
}

tests {
  test("status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns requested patient", function() {
    const data = res.getBody();
    expect(data.id).to.equal(bru.getEnvVar("patientId") || bru.getVar("patientId"));
    expect(data.firstName).to.equal("Patrick");
  });
}
