meta {
  name: Update Patient
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/patient/{{patientId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Patrick-Junior",
    "lastName": "Habimana",
    "dateOfBirth": "1992-06-14"
  }
}

tests {
  test("status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("updated patient details returned", function() {
    const data = res.getBody();
    expect(data.firstName).to.equal("Patrick-Junior");
  });
}
