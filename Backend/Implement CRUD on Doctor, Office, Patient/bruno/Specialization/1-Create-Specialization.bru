meta {
  name: Create Specialization
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/specialization
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Dermatology"
  }
}

tests {
  test("status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("returns specialization id", function() {
    const data = res.getBody();
    expect(data.id).to.be.a('string');
    bru.setEnvVar("specializationId", data.id);
    bru.setVar("specializationId", data.id);
  });
}
