meta {
  name: Assign Specialization To Doctor
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/doctor/{{doctorId}}/specialization/{{specializationId}}
  body: none
  auth: none
}

tests {
  test("status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("doctor response includes specializations", function() {
    const data = res.getBody();
    expect(Array.isArray(data.specializations)).to.be.true;
    expect(data.specializations.length).to.be.at.least(1);
  });
}
