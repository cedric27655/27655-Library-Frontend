meta {
  name: Get Doctor Specializations
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/doctor/{{doctorId}}/specializations
  body: none
  auth: none
}

tests {
  test("status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns array of specializations", function() {
    const data = res.getBody();
    expect(Array.isArray(data)).to.be.true;
  });
}
