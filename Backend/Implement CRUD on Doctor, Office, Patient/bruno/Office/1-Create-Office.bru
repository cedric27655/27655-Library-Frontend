meta {
  name: Create Office
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/office
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Consultation Room B",
    "officeNumber": 202
  }
}

tests {
  test("status is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("office id returned", function() {
    const data = res.getBody();
    expect(data.id).to.be.a('string');
    bru.setEnvVar("officeId", data.id);
    bru.setVar("officeId", data.id);
  });
}
