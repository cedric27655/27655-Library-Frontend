meta {
  name: Query 3 - Busiest Doctors Aggregate
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/appointment/query/busiest-doctors
  body: none
  auth: none
}

tests {
  test("status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns array of doctors sorted by appointment count descending", function() {
    const data = res.getBody();
    expect(Array.isArray(data)).to.be.true;
    if (data.length > 0) {
      expect(data[0]).to.have.property("doctorId");
      expect(data[0]).to.have.property("appointmentCount");
    }
  });
}
