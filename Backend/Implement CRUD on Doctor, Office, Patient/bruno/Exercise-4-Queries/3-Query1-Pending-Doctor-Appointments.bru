meta {
  name: Query 1 - Pending Doctor Appointments Ordered by Date
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/appointment/query/doctor/{{doctorId}}/pending
  body: none
  auth: none
}

tests {
  test("status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns array of pending appointments", function() {
    const data = res.getBody();
    expect(Array.isArray(data)).to.be.true;
    if (data.length > 0) {
      expect(data[0].status).to.equal("PENDING");
    }
  });
}
